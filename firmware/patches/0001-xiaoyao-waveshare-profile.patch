diff --git a/main/Kconfig.projbuild b/main/Kconfig.projbuild
--- a/main/Kconfig.projbuild
+++ b/main/Kconfig.projbuild
@@ -8,0 +9,7 @@
+config XIAOYAO_WEBSOCKET_ONLY
+    bool "Force WebSocket protocol"
+    default n
+    help
+        Use WebSocket after activation even when OTA does not provide protocol
+        configuration. This prevents a failed OTA round from falling back to MQTT.
+
diff --git a/main/application.cc b/main/application.cc
--- a/main/application.cc
+++ b/main/application.cc
@@ -501,0 +502,3 @@
+#if CONFIG_XIAOYAO_WEBSOCKET_ONLY
+    protocol_ = std::make_unique<WebsocketProtocol>();
+#else
@@ -509,0 +513,1 @@
+#endif
