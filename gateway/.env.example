# Gateway-relative SQLite path used by the startup runner.
COMPANION_DB_PATH=data/companion.db

# Public MiMo Token Plan endpoints. Do not put credentials in this file.
COMPANION_VOICE_RUNTIME=mimo
COMPANION_MIMO_OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
COMPANION_MIMO_ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
COMPANION_MIMO_API_KEY=
COMPANION_MIMO_MODEL=mimo-v2.5
COMPANION_MIMO_TTS_MODEL=mimo-v2.5-tts
COMPANION_MIMO_TTS_VOICE=mimo_default
COMPANION_MIMO_TIMEOUT_SECONDS=30
COMPANION_MIMO_MAX_RETRIES=2
COMPANION_MIMO_RETRY_BACKOFF_SECONDS=1
COMPANION_AUDIO_QUEUE_CAPACITY=256

# Auto-mode devices that omit listen/stop finish a turn after this quiet period.
COMPANION_DEVICE_AUTO_STOP_IDLE_SECONDS=1.2
# Disabled unless calibrated from aggregate PCM diagnostics. 12 frames = 720 ms.
COMPANION_DEVICE_AUTO_TURN_RMS_THRESHOLD=
COMPANION_DEVICE_AUTO_TURN_SILENCE_FRAMES=12
COMPANION_DEVICE_AUTO_TURN_MIN_SPEECH_FRAMES=5
COMPANION_DEVICE_AUTO_TURN_MAX_FRAMES=150
# Disabled unless calibrated from aggregate VAD segment diagnostics.
COMPANION_DEVICE_VAD_TURN_RMS_THRESHOLD=
# Independent guard for VAD firmware speaker-tail audio after TTS.
COMPANION_DEVICE_VAD_POST_TTS_RMS_THRESHOLD=35
COMPANION_DEVICE_POST_TTS_SILENCE_FRAMES=3

# Optional Ascend-hosted MiniCPM-o HTTP runtime. Keep real values in ignored .env.
COMPANION_MINICPM_O_ENDPOINT=
COMPANION_MINICPM_O_AUTH_TOKEN=
COMPANION_MINICPM_O_TIMEOUT_SECONDS=20
COMPANION_MINICPM_O_MAX_RETRIES=2
COMPANION_MINICPM_O_RETRY_BACKOFF_SECONDS=1

# Optional outgoing Feishu application-bot fallback. Keep real values in ignored .env.
COMPANION_FEISHU_APP_ID=
COMPANION_FEISHU_APP_SECRET=
COMPANION_FEISHU_RECEIVER_OPEN_ID=
COMPANION_FEISHU_BASE_URL=https://open.feishu.cn
COMPANION_FEISHU_TIMEOUT_SECONDS=10
COMPANION_FEISHU_MAX_RETRIES=2
COMPANION_FEISHU_RETRY_BACKOFF_SECONDS=1

# Optional single-user Feishu private text chat over the official long connection.
COMPANION_FEISHU_CHAT_ENABLED=false
COMPANION_FEISHU_CHAT_HISTORY_TURNS=6
COMPANION_FEISHU_CHAT_STARTUP_TIMEOUT_SECONDS=10

# Optional local long-term memory. Disabled by default; never store secrets here.
COMPANION_MEMORY_ENABLED=false
COMPANION_MEMORY_RETENTION_DAYS=60
COMPANION_MEMORY_QUOTA_BYTES=50000000
COMPANION_MEMORY_PROPOSAL_TTL_SECONDS=600
COMPANION_MEMORY_CLEANUP_INTERVAL_SECONDS=86400

# Optional local single-image attachment. Disabled by default; no video stream.
COMPANION_VISION_ENABLED=false
COMPANION_VISION_STORAGE_PATH=data/vision
COMPANION_VISION_MAX_UPLOAD_BYTES=10000000
COMPANION_VISION_RETENTION_DAYS=7
COMPANION_VISION_QUOTA_BYTES=200000000
COMPANION_VISION_CLEANUP_INTERVAL_SECONDS=86400
